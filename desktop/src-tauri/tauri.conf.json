{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SpotDock",
  "version": "0.1.0",
  "identifier": "com.spotdock.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "SpotDock",
        "visible": false,
        "width": 1240,
        "height": 720,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "backgroundColor": "#0b0d0c",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: http://tauri.localhost; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
